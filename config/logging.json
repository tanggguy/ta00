{
    "log_level": "INFO",
    "log_to_file": true,
    "log_to_console": true,
    "log_dir": "logs/",
    "log_format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "date_format": "%Y-%m-%d %H:%M:%S",
    "module_levels": {
        "config_loader": "INFO",
        "data_fetcher": "INFO",
        "strategies": "INFO",
        "strategies.trend_following": "INFO",
        "strategies.mean_reversion": "INFO",
        "strategies.momentum": "INFO",
        "backtest_engine": "INFO",
        "results_exporter": "INFO",
        "live_bot": "WARNING"
    },
    "rotation": {
        "enabled": true,
        "max_bytes": 10485760,
        "backup_count": 5
    }
}