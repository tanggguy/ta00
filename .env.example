# Binance API (use testnet for paper trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET_ENABLED=true


BINANCE_MAINNET_API_KEY=pk_mainnet_key_here
BINANCE_MAINNET_API_SECRET=sk_mainnet_secret_here
BINANCE_MAINNET_ENABLED=false
# Database (optional, for future use)
DATABASE_URL=sqlite:///data/trading.db

# Logging
LOG_LEVEL=INFO

# CryptoPanic API (for sentiment analysis)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
